# Entorno docker-compose de demo (Q-T06).
# Copiar a .env y ajustar antes del `docker compose up`:
#   (bash)        cp .env.example .env
#   (PowerShell)  Copy-Item .env.example .env
# Valores de demostracion; sin secretos reales (regla de oro n.10).

# --- Postgres ---
POSTGRES_USER=banca
POSTGRES_PASSWORD=banca
POSTGRES_DB=banca
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8000
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO

# --- Worker ---
# Solo puerto interno del /health del worker; no se publica al host.
WORKER_HEALTH_PORT=8100

# KYC (opcional: solo si se levanta el perfil `kyc`)
KYC_BASE_URL=http://kyc:8000
KYC_API_KEY=change-me
KYC_IMAGE=kyc-service:dev
KYC_PORT=9000

# --- Panel admin-web ---
ADMIN_WEB_PORT=8080