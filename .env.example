# Entorno docker-compose de demo (Q-T06).
# Copiar a .env y ajustar antes del `docker compose up`:
#   (bash)        cp .env.example .env
#   (PowerShell)  Copy-Item .env.example .env
# Valores de demostracion; sin secretos reales (regla de oro n.10).

# --- Postgres ---
POSTGRES_USER=banca
POSTGRES_PASSWORD=banca
POSTGRES_DB=banca
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8000
# JWT_SECRET debe ser aleatorio/fuerte (>=32 bytes, p. ej. `python -c
# "import secrets; print(secrets.token_urlsafe(48))"`). El valor `change-me`
# es solo placeholder local: el arranque falla si APP_ENV != "local" y el
# secreto sigue vacio o es el default. Nunca versionar el .env real.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO

# --- Notificaciones / OTP ---
# EMAIL_PROVIDER=mock usa el simulador (sin red); gmail envia por SMTP real.
# GMAIL_APP_PASSWORD es la contrasena de aplicacion (solo en .env, no versionar).
EMAIL_PROVIDER=mock
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Pepper HMAC-SHA256 del hash determinista del numero de documento.
DOC_HASH_PEPPER=change-me

# --- Worker ---
# Solo puerto interno del /health del worker; no se publica al host.
WORKER_HEALTH_PORT=8100

# KYC (opcional: solo si se levanta el perfil `kyc`)
KYC_BASE_URL=http://kyc:8000
KYC_API_KEY=change-me
KYC_IMAGE=kyc-service:dev
KYC_PORT=9000

# --- Titular por documento via apiinti (E1-T35, HU01) ---
# Solo server-side: el backend la recibe por docker-compose.yml (servicio
# `backend`); jamas llega al cliente. Sin secretos reales en el repo.
APIINTI_API_KEY=change-me
APIINTI_BASE_URL=https://app.apiinti.dev/api/v1

# --- Panel admin-web ---
ADMIN_WEB_PORT=8080