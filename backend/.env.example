APP_NAME=Banca Online Integral
APP_ENV=local
LOG_LEVEL=INFO

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql+psycopg://banca:banca@localhost:5432/banca

# Cache / idempotencia / colas
REDIS_URL=redis://localhost:6379/0

# Autenticacion
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# CORS (panel web y app)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Microservicio KYC (solo onboarding HU01)
KYC_BASE_URL=http://localhost:8000
KYC_API_KEY=change-me
# Timeout dedicado de /identity/verify-full (DeepFace procesa muchos frames).
# Default 60 s; el challenge/evaluate usan un timeout corto aparte.
KYC_VERIFY_TIMEOUT_SECONDS=60
# Timeout dedicado de /api/v1/document/validate (analiza la imagen del documento).
# Default 15 s; independiente del corto de challenge/evaluate y del de verify-full.
KYC_DOCUMENT_TIMEOUT_SECONDS=15

# Titular por documento via API externa (E1-T35, HU01): solo server-side.
# APIINTI_API_KEY vive en el `.env` de la raiz y se inyecta al contenedor
# `backend` (docker-compose.yml, patron ${APIINTI_API_KEY:-}); aqui solo el
# placeholder, nunca la key real. El frontend jamas la ve.
APIINTI_API_KEY=change-me
APIINTI_BASE_URL=https://app.apiinti.dev/api/v1
DOC_LOOKUP_PROVIDER=mock
DOC_LOOKUP_TIMEOUT_SECONDS=5
DOC_LOOKUP_MAX_RETRIES=2

# Validacion de titular/CCI para transferencias (E2-T08, HU06): adaptador
# `HolderLookup` con mock determinista (mismo CCI -> mismo titular); el
# proveedor real es el simulador interbancario D01. Solo server-side: la
# fachada `transactions.service.validate_holder` la consumira E2-T09 antes
# de mover dinero. Sin endpoint publico (D-07). Jamas CCI/titular en logs.
HOLDER_LOOKUP_PROVIDER=mock
HOLDER_LOOKUP_MOCK_MODE=success
HOLDER_LOOKUP_BASE_URL=http://localhost:8000
HOLDER_LOOKUP_API_KEY=change-me
HOLDER_LOOKUP_TIMEOUT_SECONDS=5
HOLDER_LOOKUP_MAX_RETRIES=2
HOLDER_LOOKUP_CACHE_TTL_SECONDS=300

# Proveedor SMS (E1-T09 aditivo): mock por defecto (sin red ni costo);
# twilio para envio real al celular (requiere cuenta Twilio).
# Esquema separado: el Account SID (AC...) va en el path de la URL
# /Accounts/{AC}/Messages.json; la API Key (SK...) es el usuario del Basic
# Auth y su secret el password. Sin SK, se usa auth clasica AC+token.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM_NUMBER=+15005550006

# Proveedor EMAIL / OTP por correo (E1-T25): mock por defecto (sin red ni
# secretos); gmail para envio real por SMTP smtp.gmail.com:587 + STARTTLS.
# GMAIL_APP_PASSWORD es la contrasena de aplicacion de 16 letras (con 2FA),
# NUNCA la contrasena de la cuenta; solo en .env, jamas en el repositorio.
EMAIL_PROVIDER=mock
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Proveedor PUSH (E6-T13, HU22): mock desacoplado por canal (determinista,
# sin red; guiones ok/down/timeout solo en pruebas). Valor desconocido ->
# ValueError fail-fast (patron SMS_PROVIDER/EMAIL_PROVIDER).
PUSH_PROVIDER=mock

# Pepper del hash del documento (E1-T24..T28): HMAC-SHA256 con este secreto.
# En produccion SIEMPRE definirlo (largo y aleatorio) y mantenerlo estable:
# cambiarlo invalida los `doc_number_hash` ya persistidos (UQ). Sin el, se usa
# un fallback constante solo para desarrollo/pruebas (ver riesgo R25).
DOC_HASH_PEPPER=change-me

# Cifrado en reposo de beneficiarios (E2-T13, HU07): clave simetrica AES-256
# (hex de 64, base64 de 32 bytes o texto libre derivado con SHA-256) e indice
# ciego HMAC-SHA256 (pepper). En produccion SIEMPRE definirlas (largo y
# aleatorio; el arranque falla fuera de `local` si faltan `cryptography` o
# estas claves). Mantenerlas estables: cambiarlas invalida los cifrados e
# indices de beneficiarios ya persistidos. Sin ellas se usan defaults SOLO de
# desarrollo/pruebas (nunca en produccion); jamas secretos reales en el repo.
BENEFICIARY_CRYPTO_KEY=change-me
BENEFICIARY_INDEX_PEPPER=change-me

# Jobs de cuotas HU12 (E3-T19): debito automatico + recordatorios.
# Mismo mecanismo que el worker del outbox (hilo daemon en el `lifespan`
# + worker dedicado); con `0` quedan inertes. Intervalo en segundos.
CREDIT_LOAN_JOBS_ENABLED=1
CREDIT_LOANS_AUTO_DEBIT_ENABLED=1
CREDIT_LOANS_REMINDERS_ENABLED=1
CREDIT_LOANS_JOBS_INTERVAL_SECONDS=3600

# Jobs de QR HU14/HU15 (E4-T07 + R-1): caducidad de `qr_charges` y reconciliacion del cobro.
# Mismo mecanismo que el worker del outbox (hilo daemon en el `lifespan`
# + worker dedicado); con `0` quedan inertes. Intervalo en segundos.
WALLET_QR_JOBS_ENABLED=1
WALLET_QR_EXPIRY_ENABLED=1
WALLET_QR_RECONCILE_ENABLED=1
WALLET_QR_JOBS_INTERVAL_SECONDS=60

# Jobs de servicios HU16 (E4-T18): recordatorios de vencimiento de servicios.
# Mismo mecanismo que el worker del outbox (hilo daemon en el `lifespan`
# + worker dedicado); con `0` quedan inertes. Intervalo en segundos.
WALLET_SERVICE_JOBS_ENABLED=1
WALLET_SERVICE_REMINDERS_ENABLED=1
WALLET_SERVICE_JOBS_INTERVAL_SECONDS=3600

# Interoperabilidad de billetera con el sistema par (E4-T03, HU13 CA-03):
# adaptador `WalletInteropGateway` (estandares `BO-QR1`, D06) con mock
# determinista por defecto (sin red); `http` valida la contraparte contra
# `POST {base_url}/interop/counterparts/validate` con timeout/reintentos/
# circuito. La API key es server-side (solo cabecera); jamas en el repo.
WALLET_INTEROP_PROVIDER=mock
WALLET_INTEROP_MOCK_MODE=success
WALLET_INTEROP_BASE_URL=http://localhost:8000
WALLET_INTEROP_API_KEY=change-me
WALLET_INTEROP_TIMEOUT_SECONDS=5
WALLET_INTEROP_MAX_RETRIES=2

# Proveedor de servicios para HU16 (E4-T16, catalogo `billers`):
# adaptador `ServiceProviderGateway` (busqueda por nombre/suministro +
# validacion determinista) con mock por defecto (sin red); `http`
# valida el suministro contra `POST
# {base_url}/services/supply/validate` con timeout/reintentos/
# circuito. La API key es server-side (solo cabecera); jamas en el repo.
SERVICE_PROVIDER=mock
SERVICE_PROVIDER_MOCK_MODE=success
SERVICE_PROVIDER_BASE_URL=http://localhost:8000
SERVICE_PROVIDER_API_KEY=change-me
SERVICE_PROVIDER_TIMEOUT_SECONDS=5
SERVICE_PROVIDER_MAX_RETRIES=2

# Liquidacion de servicios/recargas HU16 (E4-T17, `docs/04#7.10`):
# UUID de la cuenta `accounts` interna de liquidacion del proveedor
# (una por moneda; `ACTIVE` y con la moneda del pago; la resuelve la
# fachada `accounts`, sin columna nueva en `billers`). Sin ella el
# pago/recarga se rechaza fail-closed antes de operar (sin mover dinero).
# El default apunta a la cuenta demo determinista (PEN) sembrada por la
# migracion `0046_services_settlement` (mismo UUID en `.env.example` de la
# raiz y `docker-compose.yml`); en produccion, el UUID real del proveedor.
WALLET_SERVICES_SETTLEMENT_ACCOUNT_ID=d0000000-0000-4000-8000-000000000001
