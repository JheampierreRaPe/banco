APP_NAME=Banca Online Integral
APP_ENV=local
LOG_LEVEL=INFO

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql+psycopg://banca:banca@localhost:5432/banca

# Cache / idempotencia / colas
REDIS_URL=redis://localhost:6379/0

# Autenticacion
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# CORS (panel web y app)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Microservicio KYC (solo onboarding HU01)
KYC_BASE_URL=http://localhost:8000
KYC_API_KEY=change-me
