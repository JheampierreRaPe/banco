# Q-T06: imagen demo del backend (FastAPI + migraciones).
# Construida contra todo el contexto del repo; copia solo lo necesario.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv/app

COPY backend/pyproject.toml backend/alembic.ini ./
COPY backend/app ./app
COPY backend/migrations ./migrations
RUN pip install .

EXPOSE 8000

# Migra al arranque (demo idempotente con `alembic upgrade head`) y sirve la API.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]